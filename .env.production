# =============================================================================
# PUBLIC BUILD DEFAULTS
# =============================================================================
# Only values that are PUBLIC BY DESIGN belong in this file.
#
# Next.js inlines NEXT_PUBLIC_* at build time, so these two are already present
# in the JavaScript every visitor downloads. Supabase's publishable key is
# specifically intended for client exposure: it grants nothing on its own, and
# row level security is the real boundary (every table has RLS enabled and no
# policy grants the anon role access to user data).
#
# Committing them means the repository builds anywhere without extra setup.
# Anything defined in the hosting provider's environment settings overrides
# this file, so moving them to Vercel later needs no code change.
#
# NEVER put a secret here: service role key, Stripe secret, AI keys, search
# keys. Those belong only in the deployment environment. See .env.example.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://mfvomtwwnkqsaiqzjbxy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_njz0Seq43wtwpE5zhRriRQ_CiQZLKe3
