# =============================================================================
# ATTUREL — ENVIRONMENT
# Copy to .env.local for development. Never commit .env.local.
# Tiers:  [CORE]      required for the app to boot
#         [OPTIONAL]  feature degrades gracefully without it
#         [PROD]      only needed in a deployed production environment
# =============================================================================

# --- APP ---------------------------------------------------------------------
# [CORE] Absolute origin, no trailing slash. Drives auth redirects, email links,
# canonical URLs and OG images. On Vercel this is inferred if omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SUPABASE ----------------------------------------------------------------
# [CORE] Project URL and publishable (anon) key. Safe to expose to the browser;
# every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [PROD] Service role key. Bypasses RLS — server-only, never sent to the client.
# Required for: Stripe webhooks (writing subscription state with no user session)
# and the account-deletion job. The app boots without it; those paths return 503.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
# [OPTIONAL] A key is all that is needed. With none, Atturel runs the `grounded`
# provider: deterministic, evidence-composed output built from your own data.
# Honest, but not generative.
#
# AI_PROVIDER and AI_MODEL are BOTH OPTIONAL and normally left unset. The
# provider is inferred from whichever key is present, and the model defaults to
# one that suits that provider.
#
#   AI_PROVIDER  anthropic | openai | grounded
#                Set it only to break a tie when both keys exist, or to
#                'grounded' to switch generation off while leaving keys in place.
#                CAUTION: a stale AI_PROVIDER=grounded in your deployment will
#                keep AI off no matter what key you add. It is an off switch.
#   AI_MODEL     Overrides the per-provider default.
AI_PROVIDER=
AI_MODEL=
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- EMAIL -------------------------------------------------------------------
# [OPTIONAL] Without a key, emails are logged to the server console instead of
# being delivered, so flows remain testable in development.
RESEND_API_KEY=
# [PROD] Must be a domain verified in Resend, otherwise delivery is rejected.
EMAIL_FROM_ADDRESS=hello@atturel.app

# --- STRIPE ------------------------------------------------------------------
# [OPTIONAL] Billing surfaces render in a read-only state without these. The app
# builds and boots with all of them blank; upgrading simply says payments are
# not connected. Full setup: docs/STRIPE_PRODUCTION_SETUP.md.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint at /api/stripe/webhook. Without it the webhook
# answers 503, which means a payment can succeed and no plan ever changes.
# NOTE: the webhook writes with SUPABASE_SERVICE_ROLE_KEY above. That key is
# required too, and its absence fails the same way.
STRIPE_WEBHOOK_SECRET=
# Validated but unread. Checkout is Stripe-hosted, so no Stripe.js runs in the
# browser and there is nothing for a publishable key to do. Kept so setting it
# is harmless rather than a boot error.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs from the Stripe dashboard, both recurring, on one "Atturel Pro"
# product: $19 USD/month and $190 USD/year. The displayed prices live in
# src/lib/billing/plans.ts and must agree with what Stripe charges -- these
# variables decide which price is billed, that file decides what is shown.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- CALENDAR ----------------------------------------------------------------
# [OPTIONAL] Read-only. Atturel never creates, edits, accepts or declines
# anything in a calendar; the provider interface has no vocabulary for it.
#
# Required for EITHER provider. Without it, Connect refuses to start rather
# than storing a refresh token in the clear, and both show as Unavailable.
# Generate with: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=

# Microsoft 365 / Outlook. Least privilege: Calendars.Read, plus openid, email
# and offline_access. MICROSOFT_TENANT defaults to 'common', which is what lets
# users from any Entra organization and personal Microsoft accounts connect.
# Set a tenant id only to restrict Atturel to a single organization.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# Google Calendar. Least privilege: calendar.events.readonly, which is narrower
# than calendar.readonly. Note that scope is 'sensitive', so Google verification
# is required before accounts outside your test-user list can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ANALYTICS & OBSERVABILITY -----------------------------------------------
# [OPTIONAL] Events are structured-logged when no sink is configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
SENTRY_DSN=

# --- DEV ONLY ----------------------------------------------------------------
# Guard rail: seeding refuses to run unless this is exactly "true".
ALLOW_DB_SEED=false

# --- RESEARCH -----------------------------------------------------------------
# [OPTIONAL] Source DISCOVERY (name -> candidate URLs) needs a search key.
# Analysing a URL the user pastes needs nothing, so Research Person still works
# without this — it just cannot find sources on its own.
#
# A key is the whole configuration. SEARCH_PROVIDER is OPTIONAL and normally
# left unset: the provider is inferred from whichever key is present, with Exa
# preferred when more than one is. Set it only to force a choice, or to 'none'
# to switch discovery off while leaving the keys in place.
#
#   SEARCH_PROVIDER  exa | brave | serper | mock | none
#                    CAUTION: a stale SEARCH_PROVIDER=none keeps discovery off
#                    no matter what key you add. It is an off switch.
#                    'mock' is a deterministic development provider; it refuses
#                    to run in production so it can never invent evidence.
SEARCH_PROVIDER=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
