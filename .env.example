# =============================================================================
# AUREL — ENVIRONMENT
# Copy to .env.local for development. Never commit .env.local.
# Tiers:  [CORE]      required for the app to boot
#         [OPTIONAL]  feature degrades gracefully without it
#         [PROD]      only needed in a deployed production environment
# =============================================================================

# --- APP ---------------------------------------------------------------------
# [CORE] Absolute origin, no trailing slash. Drives auth redirects, email links,
# canonical URLs and OG images. On Vercel this is inferred if omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SUPABASE ----------------------------------------------------------------
# [CORE] Project URL and publishable (anon) key. Safe to expose to the browser;
# every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [PROD] Service role key. Bypasses RLS — server-only, never sent to the client.
# Required for: Stripe webhooks (writing subscription state with no user session)
# and the account-deletion job. The app boots without it; those paths return 503.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
# [OPTIONAL] Provider selection. Without an API key Atturel runs the `grounded`
# provider: deterministic, evidence-composed output built from your own data.
# It is honest but not generative — set a key for full quality.
# AI_PROVIDER: anthropic | openai | grounded
AI_PROVIDER=grounded
AI_MODEL=claude-opus-5
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- EMAIL -------------------------------------------------------------------
# [OPTIONAL] Without a key, emails are logged to the server console instead of
# being delivered, so flows remain testable in development.
RESEND_API_KEY=
# [PROD] Must be a domain verified in Resend, otherwise delivery is rejected.
EMAIL_FROM_ADDRESS=hello@atturel.app

# --- STRIPE ------------------------------------------------------------------
# [OPTIONAL] Billing surfaces render in a read-only state without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs from the Stripe dashboard. Plan limits live in src/lib/billing/plans.ts.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- CALENDAR (GOOGLE) -------------------------------------------------------
# [OPTIONAL] Least-privilege: calendar.readonly only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CALENDAR (MICROSOFT) ----------------------------------------------------
# [OPTIONAL] Least-privilege: Calendars.Read only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- ANALYTICS & OBSERVABILITY -----------------------------------------------
# [OPTIONAL] Events are structured-logged when no sink is configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
SENTRY_DSN=

# --- DEV ONLY ----------------------------------------------------------------
# Guard rail: seeding refuses to run unless this is exactly "true".
ALLOW_DB_SEED=false

# --- RESEARCH -----------------------------------------------------------------
# [OPTIONAL] Source DISCOVERY (name -> candidate URLs) needs a search key.
# Analysing a URL the user pastes needs nothing, so Research Person still works
# without this — it just cannot find sources on its own.
# SEARCH_PROVIDER: brave | serper | none
SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
